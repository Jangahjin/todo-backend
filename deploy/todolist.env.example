# 실제 값을 채운 뒤 파일명을 todolist.env로 바꿔 EC2의 /etc/todolist/에 WinSCP로 직접 업로드한다.
# 이 파일(.example)만 Git에 커밋하고, 값이 채워진 todolist.env는 절대 커밋하지 않는다.
#
# 아래 키 이름은 application.properties/application-prod.properties가 실제로 참조하는
# ${ENV_VAR} 이름과 정확히 일치해야 한다. 이름이 다르면 플레이스홀더 resolve 실패로 기동이
# 안 된다 — 특히 OAUTH_GOOGLE_CLIENT_ID/SECRET, APP_FRONTEND_URL은 흔히 쓰는 이름
# (GOOGLE_CLIENT_ID, FRONTEND_URL)과 다르니 주의.

DB_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/postgres?currentSchema=todolistdb
DB_USERNAME=postgres
DB_PASSWORD=

JWT_SECRET=

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

APP_FRONTEND_URL=

AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
# EC2 인스턴스에 IAM Role을 연결했다면 아래 두 줄은 비워두거나 삭제한다
# (DefaultCredentialsProvider가 IAM Role을 우선 사용한다).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
