# 실제 값을 채운 뒤 파일명을 todolist.env로 바꿔 EC2의 /etc/todolist/에 WinSCP로 직접 업로드한다.
# 이 파일(.example)만 Git에 커밋하고, 값이 채워진 todolist.env는 절대 커밋하지 않는다.
#
# 아래 키 이름은 application.properties/application-prod.properties가 실제로 참조하는
# ${ENV_VAR} 이름과 정확히 일치해야 한다. 이름이 다르면 플레이스홀더 resolve 실패로 기동이
# 안 된다 — 특히 OAUTH_GOOGLE_CLIENT_ID/SECRET, APP_FRONTEND_URL은 흔히 쓰는 이름
# (GOOGLE_CLIENT_ID, FRONTEND_URL)과 다르니 주의.

DB_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/postgres?currentSchema=todolistdb
DB_USERNAME=postgres
DB_PASSWORD=

JWT_SECRET=

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# 경로 없이 오리진만 적는다(끝에 / 도 붙이지 않는다) — CORS 허용 오리진 비교와
# OAuth2 로그인 성공 후 리다이렉트 베이스에 같은 값이 쓰인다.
APP_FRONTEND_URL=

# CloudFront 등 리버스 프록시 뒤에 둘 때만 필요하다. 프록시가 X-Forwarded-Proto를 보내지
# 않으면 Spring이 {baseUrl}을 http로 계산해 Google이 redirect_uri_mismatch로 거부한다.
# 값은 Google Console의 승인된 리디렉션 URI와 글자 하나까지 같아야 한다.
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_REDIRECT_URI=https://<프론트가 호출하는 백엔드 도메인>/login/oauth2/code/google

AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
# ⚠️ EC2에 IAM Role을 연결했더라도 아래 두 줄에 값이 있으면 그 값이 먼저 쓰인다 —
# DefaultCredentialsProvider는 환경변수를 IAM Role보다 앞서 확인한다. Role을 쓰려면
# 반드시 두 줄을 비우거나 지운다.
# ⚠️ 키를 적을 때는 오타·잘린 값·줄 끝 공백을 조심한다. 값이 틀려도 기동은 정상이고
# presigned URL 발급도 성공하며, 브라우저가 S3에 업로드하는 순간에만 403
# (SignatureDoesNotMatch)으로 실패한다 — 원인 찾기가 매우 어렵다(2026-09-10 실제 발생).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
